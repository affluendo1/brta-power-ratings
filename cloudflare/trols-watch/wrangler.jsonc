{
  "name": "brta-trols-watcher",
  "main": "worker.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "WATCH_STATE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
